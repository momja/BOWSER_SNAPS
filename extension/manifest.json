{
  "manifest_version": 3,
  "name": "Bowser Snaps",
  "version": "1.2.0",
  "minimum_chrome_version": "111",
  "description": "Region screenshots (like macOS Cmd+Shift+4) that embed DOM & component metadata into the PNG — built for filing LLM-ready bug reports.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bowser Snaps",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "start-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Snap a region of the page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-agent.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
