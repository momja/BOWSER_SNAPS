{
  "name": "bowser-snaps",
  "version": "1.1.0",
  "description": "Region screenshots with DOM/component metadata embedded in the PNG — SDK + Chrome extension",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./sdk/index.js",
    "./sdk/*": "./sdk/*"
  },
  "files": [
    "sdk",
    "tools/extract-metadata.mjs"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node test/png-meta.test.mjs",
    "test:e2e": "xvfb-run -a node test/e2e.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.54.0"
  }
}
